EXPRESS_PORT=5500

# --- Supabase (server + optional tooling) ------------------------------------
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon public key (same as NEXT_PUBLIC_* below) — passed to API container if you use it elsewhere
SUPABASE_ANON_KEY=your_anon_key_here

# service_role key — SERVER ONLY. Dashboard → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret for verifying Bearer tokens from the client.
# Dashboard → Project Settings → API → JWT Secret (legacy: sometimes under "JWT Settings")
SUPABASE_JWT_TOKEN=your_jwt_secret_here

# Optional: only if you use direct DB tooling; not required for this app’s Node code
SUPABASE_DB_PASSWORD=
SUPABASE_PORT=5432

# --- Redis (external — Compose does not run Redis) ----------------------------
# Use a cloud Redis URL or host.docker.internal if Redis runs on your machine.
# From inside Docker, "localhost" is the container itself — use host.docker.internal (Desktop) or the host IP.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# If your Redis has no ACL user, leave REDIS_USERNAME empty; you may need a local redis URL tweak in server/redis/config.js for empty usernames.

# --- Frontend (lumina-web — NEXT_PUBLIC_* is embedded at build time in Docker)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your_anon_key_here

# Browser calls the API here. Docker Desktop: http://host.docker.internal:5500
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5500

# Used for OAuth redirect and absolute links. Docker: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Grafana ----------------------------------------------------------------
GF_SECURITY_ADMIN_USERNAME=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_strong_password

# --- Optional: Next.js server only (local `next dev`, not in Compose) --------
# SITE_COOKIE_DOMAIN=.yourdomain.com
